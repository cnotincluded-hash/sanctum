{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanctum",
  "version": "1.0.0",
  "identifier": "com.caffeinenotincluded.sanctum",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sanctum",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your arcane study for habits, focus and quests",
    "longDescription": "Sanctum is a cozy productivity study: daily rituals, quests, a focus timer, health logs, fasting, a journal, lofi streams and an RPG that grows with you, kept in sync with your account across the website and your devices.",
    "copyright": "Caffeine Not Included",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
